# Variables d'environnement requises pour VTCLAND.
# Copier ce fichier en .env.local et renseigner les valeurs réelles.

# URL publique du site (utilisée pour les canonicals, OG, sitemap).
NEXT_PUBLIC_SITE_URL=https://vtcland.fr
VTCLAND_API_URL=https://api-vtcland-production.up.railway.app
VTCLAND_DRIVER_API_TOKEN=
DRIVER_DASHBOARD_PASSWORD=
DRIVER_SESSION_SECRET=

# Clé API Anthropic (chat "Élia") — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Secret utilisé pour signer les tokens à usage unique de /api/devis.
# Générer une valeur aléatoire longue, ex: `openssl rand -hex 32`.
DEVIS_SECRET=

# Clé API Google Places (New) — note et avis réels affichés dans SceneSocialProof.
# Activer "Places API (New)" (pas l'ancienne "Places API") sur un projet Google
# Cloud avec facturation active : https://console.cloud.google.com/apis/library/places.googleapis.com
# Optionnelle : sans elle, la section affiche un simple lien vers la fiche
# Google plutôt que d'inventer une note ou des témoignages.
GOOGLE_PLACES_API_KEY=

# Monitoring d'erreurs Sentry (optionnel — https://sentry.io/).
# Un DSN n'est pas un secret (il est de toute façon exposé côté client),
# d'où le préfixe NEXT_PUBLIC_. Laisser vide en local : le SDK reste inactif.
NEXT_PUBLIC_SENTRY_DSN=
# Optionnels, uniquement pour l'upload de source maps au build :
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
